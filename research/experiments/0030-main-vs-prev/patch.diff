++/// Polyglot move word: to file, to rank, from file, from rank (no promotion).
++fn raw_move(from: (u16, u16), to: (u16, u16)) -> u16 {
++    to.0 | (to.1 << 3) | (from.0 << 6) | (from.1 << 9)
++}
