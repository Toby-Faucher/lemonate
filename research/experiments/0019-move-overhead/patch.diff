+    let mv = bestmove(&out).expect("bestmove");
+    assert!(mv == "e2e4" || mv == "d2d4", "not a book move: {mv}");
+    assert!(out.iter().any(|l| l == "info string book move"), "{out:?}");
+    assert!(!searched(&out), "a book move must not start a search: {out:?}");
+}
