+impl HistoryTable {
+    /// Capture history score; 0 for non-captures.
+    #[inline]
+    pub fn get_capture(&self, color: Color, mv: &Move) -> i32 {
+        match mv.captured {
+            Some(c) => {
+                self.capture[color as usize][mv.piece.piece_type as usize][mv.to.index()]
+                    [c.piece_type as usize]
+            }
+            None => 0,
+        }
+    }
+
+    /// Apply a signed, gravity-scaled bonus to a capture (negative = malus).
+    fn bump_capture(&mut self, color: Color, mv: &Move, bonus: i32) {
+        if let Some(c) = mv.captured {
+            let e = &mut self.capture[color as usize][mv.piece.piece_type as usize][mv.to.index()]
+                [c.piece_type as usize];
+            *e = (*e + bonus - (*e * bonus.abs() / MAX_HISTORY_SCORE))
+                .clamp(-MAX_HISTORY_SCORE, MAX_HISTORY_SCORE);
+        }
+    }
+
+    /// Reward the capture that cut off and penalise the captures that failed before it.
+    /// `best_move` is `None` when a quiet move cut off (captures only get the malus).
+    pub fn update_captures(&mut self, color: Color, best_move: Option<&Move>, failed: &[Move], depth: i32) {
+        let bonus = history_bonus(depth);
+        if let Some(mv) = best_move {
+            self.bump_capture(color, mv, bonus);
+        }
+        for mv in failed {
+            self.bump_capture(color, mv, -bonus);
+        }
+    }
+}
+
