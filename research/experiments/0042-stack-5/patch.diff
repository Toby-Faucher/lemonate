+                -pc_beta,
+                -pc_beta + 1,
+                ply + 1,
+                None,
+            );
+            self.path.pop();
+            board.undo_move(mv, undo);
+            if self.should_stop() {
+                return None;
+            }
+            if score >= pc_beta && !is_mate_score(score) {
+                return Some(score);
+            }
+        }
